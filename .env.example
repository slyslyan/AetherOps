# ── AetherOps Environment Config ──
# Copy to .env and fill in your values.
# All variables are optional; defaults are documented below.

# ~~~ LLM Provider ~~~
# Provider backend: deepseek, openai, anthropic, ollama
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com/v1

# ~~~ Transport ~~~
# Communication between Python control plane and Go data plane: mcp or grpc
AETHEROPS_TRANSPORT=mcp
AETHEROPS_MCP_ADDR=http://localhost:50052
AETHEROPS_GRPC_ADDR=localhost:50051

# ~~~ Analysis ~~~
# Maximum LLM multi-turn diagnosis rounds
MAX_DIAGNOSIS_TURNS=2
# Minimum anomaly score to trigger diagnosis
ANOMALY_MIN_SCORE=0.5

# ~~~ Metrics ~~~
PROMETHEUS_URL=http://localhost:9090
# Port for the AetherOps agent metrics endpoint
AETHEROPS_METRICS_PORT=9093

# ~~~ Alert Correlation ~~~
ALERT_WINDOW_SECONDS=60
ALERT_STORM_THRESHOLD=20

# ~~~ Storage ~~~
# Leave empty for defaults (~/.aetherops/feedback, ~/.aetherops/incidents)
AETHEROPS_FEEDBACK_DIR=
AETHEROPS_INCIDENT_DIR=

# ~~~ Policy ~~~
POLICY_FILE=

# ~~~ Probe ~~~
HTTP_PROBE_TARGET=/proc/self/exe
EBPF_IFACE=ens33

# ~~~ Simulation ~~~
SIMULATE_LATENCY=0
SIMULATED_DELAY_MS=2000
